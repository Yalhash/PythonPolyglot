# OpenAI API Configuration (Optional - only needed for translation and response generation)
# Transcription now works locally for free!
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Google Translate API (alternative to OpenAI for translation)
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# Whisper Model Settings (Local transcription)
WHISPER_MODEL_SIZE=base
# Options: tiny, base, small, medium, large-v2, large-v3
# Smaller = faster but less accurate, Larger = slower but more accurate
WHISPER_DEVICE=auto
# Options: cpu, cuda, auto

# User Preferences
USER_LANGUAGE=en
AUTO_DETECT_SOURCE_LANGUAGE=true

# Audio Settings
AUDIO_DEVICE_ID=
SAMPLE_RATE=16000
CHUNK_DURATION_SECONDS=5

# Window Settings
WINDOW_OPACITY=0.9
WINDOW_X=100
WINDOW_Y=100

